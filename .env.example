# Optional overrides for docker compose. Default credentials are for local development.
DUBHE_TRACING_PORT=4318
DUBHE_UI_PORT=3000
# DUBHE_TRACING_IMAGE=crpi-62dr2n7q1cuj1elz.cn-shanghai.personal.cr.aliyuncs.com/stride/dubhe-tracing:2026.11.1
# DUBHE_TRACING_PLATFORM=linux/amd64
DUBHE_CONFIG_FILE=./config.example.yaml
DUBHE_MYSQL_PASSWORD=dubhe-dev-db
DUBHE_MYSQL_ROOT_PASSWORD=dubhe-dev-root

# Match the corresponding auth entries in DUBHE_CONFIG_FILE.
DUBHE_UI_READER_KEY=local-reader-key
# Host-side keys for the Agent and Compose smoke test.
DUBHE_REGISTRATION_API_KEY=local-registration-key
DUBHE_WORKLOAD_API_KEY=local-workload-key
